  m_Name: 
  m_EditorClassIdentifier: 
  orders:
  - title: "\u7B2C\u4E00\u5355\uFF1A\u65B0\u9C9C\u6742\u9C7C"
    brief: "\u4F60\u6D77\u4E0A\u90A3\u624B\u672C\u4E8B\uFF0C\u738B\u8001\u677F\u65E9\u5C31\u89C1\u8BC6\u8FC7\u4E86\u3002\u8FD9\u56DE\u4ED6\u60F3\u770B\u7684\u662F\u5DE5\u5382\u90A3\u5934\u2014\u2014\u5148\u4ECE\u7A33\u5B9A\u7684\u6742\u9C7C\u8D27\u6E90\u5F00\u59CB\u3002"
    itemId: "\u6742\u9C7C"
    amount: 10
    blocks: 2
    unlockName: "\u5206\u62E3\u533A"
    extraUnlocks: []
  - title: "\u7B2C\u4E8C\u5355\uFF1A\u6C99\u4E01\u9C7C"
    brief: "\u6742\u9C7C\u5356\u5F97\u4E0D\u9519\u3002\u738B\u8001\u677F\u8981\u6311\u4E2A\u5934\u5300\u79F0\u7684\u6C99\u4E01\u9C7C\uFF0C\u770B\u770B\u4F60\u5206\u62E3\u5F97\u7EC6\u4E0D\u7EC6\u3002"
    itemId: "\u6C99\u4E01\u9C7C"
    amount: 2
    blocks: 1
    unlockName: "\u9884\u5904\u7406\u5382"
    extraUnlocks: []
  - title: "\u7B2C\u4E09\u5355\uFF1A\u5256\u597D\u7684\u5927\u9EC4\u9C7C"
    brief: "\u6837\u54C1\u5F97\u5E72\u51C0\u6F02\u4EAE\u3002\u628A\u5927\u9EC4\u9C7C\u5256\u597D\u3001\u53BB\u5185\u810F\uFF0C\u9C7C\u8EAB\u5B8C\u6574\u5730\u9001\u8FC7\u6765\u3002"
    itemId: "\u5927\u9EC4\u9C7C@Fillet"
    amount: 3
    blocks: 1
    unlockName: "\u6210\u578B\u5382"
    extraUnlocks: []
  - title: "\u7B2C\u56DB\u5355\uFF1A\u88F9\u7C89\u6742\u9C7C"
    brief: "\u738B\u8001\u677F\u60F3\u8BD5\u4E2A\u65B0\u4EA7\u54C1\u2014\u2014\u88F9\u4E0A\u7C89\u7684\u6742\u9C7C\uFF0C\u4ED6\u62FF\u53BB\u70B8\u7740\u5356\u3002"
    itemId: "\u6742\u9C7C@Fillet,Breading"
    amount: 5
    blocks: 2
    unlockName: "\u70DF\u718F\u623F"
    extraUnlocks: []
  - title: "\u7B2C\u4E94\u5355\uFF1A\u718F\u5927\u9EC4\u9C7C"
    brief: "\u718F\u6742\u9C7C\u6253\u5F00\u4E86\u9500\u8DEF\u3002\u738B\u8001\u677F\u60F3\u8BD5\u8BD5\u6574\u6761\u7684\u718F\u5927\u9EC4\u9C7C\u2014\u2014\u987A\u4FBF\u542C\u8BF4\u4F60\u5382\u5B50\u8001\u662F\u8DF3\u7535\uFF0C\u4ED6\u613F\u610F\u5E2E\u4F60\u642D\u4E24\u6761\u8FDC\u7A0B\u8F93\u7535\u7684\u7EBF\u3002"
    itemId: "\u5927\u9EC4\u9C7C@Fillet,Smoked"
    amount: 4
    blocks: 2
    unlockName: "\u63A5\u6536\u5854"
    extraUnlocks:
    - "\u68F1\u955C\u5854"
  - title: "\u7B2C\u516D\u5355\uFF1A\u70DF\u718F\u6742\u9C7C"
    brief: "\u718F\u5473\u538B\u4F4F\u4E86\u6742\u9C7C\u7684\u8165\uFF0C\u5BA2\u4EBA\u5F88\u4E70\u8D26\u3002\u518D\u6765\u4E00\u6279\u3002"
    itemId: "\u6742\u9C7C@Fillet,Smoked"
